# Public canonical URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://ruro.in

# Optional: where enquiries are forwarded (Slack/Make/Zapier/your CRM webhook).
# When unset, enquiries are validated and logged on the server only.
ENQUIRY_WEBHOOK_URL=

# Optional: send enquiries into a Google Form (Responses tab / linked Sheet).
# URL is the form's address with /viewform changed to /formResponse. FIELDS maps each enquiry field
# (name, email, phone, role, company, link, business, service, receivedAt) to its entry id.
GOOGLE_FORM_URL=
GOOGLE_FORM_FIELDS=

# Optional: public contact address shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=aaru@ruro.in

# Optional: cookieless analytics (Plausible). Set to the site's domain, e.g. ruro.in.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: custom Plausible script URL (defaults to plausible.io's manual script).
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Optional: Microsoft Clarity project ID for heatmaps and recordings. Loaded only after a
# visitor allows it; form fields are masked.
NEXT_PUBLIC_CLARITY_ID=

# Optional: a booking page (Cal.com, Calendly…). Shows "Book a call" on the contact page.
NEXT_PUBLIC_BOOKING_URL=
